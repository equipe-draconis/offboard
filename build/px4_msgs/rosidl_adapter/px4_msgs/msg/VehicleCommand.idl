      const uint16 VEHICLE_CMD_DO_WINCH = 42600;
      @verbatim (language="comment", text=
        "Comandos de correção externa para algoritmos de estimação de estado (EKF2) em cenários de navegação estimada (Dead Reckoning)" "\n"        "Reseta/Injeta posição global externa estimada no filtro de Kalman")
      const uint16 VEHICLE_CMD_EXTERNAL_POSITION_ESTIMATE = 43003;
      @verbatim (language="comment", text=
        "Injeta vetor de estimativa de vento externo para ajuste de controle aerodinâmico")
      const uint16 VEHICLE_CMD_EXTERNAL_WIND_ESTIMATE = 43004;
      @verbatim (language="comment", text=
        "--- EXTENSÕES INTERNAS EXCLUSIVAS DO ECOSSISTEMA PX4 ---" "\n"        "Marcador inicial para comandos exclusivos que operam acima do limite de 16-bits do MAVLink")
      const uint32 VEHICLE_CMD_PX4_INTERNAL_START = 65537;
      @verbatim (language="comment", text=
        "param5/6/7: Coordenadas de origem física local (Lat/Lon/Alt AMSL vinda do receptor GNSS)" "\n"        "Define a origem geográfica global absoluta que representará o ponto (0,0,0) local do EKF2")
      const uint32 VEHICLE_CMD_SET_GPS_GLOBAL_ORIGIN = 100000;
      @verbatim (language="comment", text=
        "param1: Estado de navegação alvo mapeado diretamente conforme a máquina de estados interna do Commander do PX4")
      const uint32 VEHICLE_CMD_SET_NAV_STATE = 100001;
      @verbatim (language="comment", text=
        "--- SUB-ENUMERATIONS E MÁSCARAS DE DADOS PARA PARÂMETROS ESPECÍFICOS ---" "\n"        "Modos de operação de Gimbal/Mount (Injetados via param1 ou param7 em comandos de Mount)" "\n"        "Recolhe o gimbal para a posição de proteção, desativa estabilização e desliga motores")
      const uint8 VEHICLE_MOUNT_MODE_RETRACT = 0;
      @verbatim (language="comment", text=
        "Move o gimbal para o centro neutro estático alinhado com a estrutura física da aeronave")
      const uint8 VEHICLE_MOUNT_MODE_NEUTRAL = 1;
      @verbatim (language="comment", text=
        "Transfere o controle dos eixos para setpoints dinâmicos via MAVLink com estabilização ativa")
      const uint8 VEHICLE_MOUNT_MODE_MAVLINK_TARGETING = 2;
      @verbatim (language="comment", text=
        "Vincula o controle de apontamento diretamente aos canais mapeados no rádio controle (RC)")
      const uint8 VEHICLE_MOUNT_MODE_RC_TARGETING = 3;
      @verbatim (language="comment", text=
        "Trava o foco da câmera apontado fixamente para uma coordenada global (Lat/Lon/Alt)")
      const uint8 VEHICLE_MOUNT_MODE_GPS_POINT = 4;
      const uint8 VEHICLE_MOUNT_MODE_ENUM_END = 5;
      @verbatim (language="comment", text=
        "Modos de operação de Região de Interesse / ROI (Injetados via param1)" "\n"        "Cancela foco em alvos, sensores retornam para comportamento padrão de voo")
      const uint8 VEHICLE_ROI_NONE = 0;
      @verbatim (language="comment", text=
        "Mantém os sensores apontados continuamente na direção do próximo waypoint da rota")
      const uint8 VEHICLE_ROI_WPNEXT = 1;
      @verbatim (language="comment", text=
        "Trava o apontamento dos sensores para um waypoint específico da lista pelo seu ID")
      const uint8 VEHICLE_ROI_WPINDEX = 2;
      @verbatim (language="comment", text=
        "Fixa o apontamento dos sensores para uma coordenada geográfica estática no espaço")
      const uint8 VEHICLE_ROI_LOCATION = 3;
      @verbatim (language="comment", text=
        "Habilita rastreamento contínuo de um alvo dinâmico móvel rastreado pelo sistema")
      const uint8 VEHICLE_ROI_TARGET = 4;
      const uint8 VEHICLE_ROI_ENUM_END = 5;
      @verbatim (language="comment", text=
        "Ações de atuação do subsistema de paraquedas de emergência")
      const uint8 PARACHUTE_ACTION_DISABLE = 0;
      const uint8 PARACHUTE_ACTION_ENABLE = 1;
      @verbatim (language="comment", text=
        "Ejeta fisicamente o paraquedas cortando os motores no processo")
      const uint8 PARACHUTE_ACTION_RELEASE = 2;
      @verbatim (language="comment", text=
        "Mapeamento de unidades de hardware para o comando de injeção de falhas simuladas (VEHICLE_CMD_INJECT_FAILURE)")
      const uint8 FAILURE_UNIT_SENSOR_GYRO = 0;
      const uint8 FAILURE_UNIT_SENSOR_ACCEL = 1;
      const uint8 FAILURE_UNIT_SENSOR_MAG = 2;
      const uint8 FAILURE_UNIT_SENSOR_BARO = 3;
      const uint8 FAILURE_UNIT_SENSOR_GPS = 4;
      const uint8 FAILURE_UNIT_SENSOR_OPTICAL_FLOW = 5;
      const uint8 FAILURE_UNIT_SENSOR_VIO = 6;
      const uint8 FAILURE_UNIT_SENSOR_DISTANCE_SENSOR = 7;
      const uint8 FAILURE_UNIT_SENSOR_AIRSPEED = 8;
      const uint8 FAILURE_UNIT_SYSTEM_BATTERY = 100;
      const uint8 FAILURE_UNIT_SYSTEM_MOTOR = 101;
      const uint8 FAILURE_UNIT_SYSTEM_SERVO = 102;
      const uint8 FAILURE_UNIT_SYSTEM_AVOIDANCE = 103;
      const uint8 FAILURE_UNIT_SYSTEM_RC_SIGNAL = 104;
      const uint8 FAILURE_UNIT_SYSTEM_MAVLINK_SIGNAL = 105;
      @verbatim (language="comment", text=
        "Tipos de assinatura de falha a serem injetadas no comportamento do componente alvo selecionado" "\n"        "Retorna o componente ao comportamento operacional normal")
      const uint8 FAILURE_TYPE_OK = 0;
      @verbatim (language="comment", text=
        "Simula desligamento completo ou perda total de comunicação com o dispositivo")
      const uint8 FAILURE_TYPE_OFF = 1;
      @verbatim (language="comment", text=
        "Trava a leitura do sensor no último valor válido lido antes da falha")
      const uint8 FAILURE_TYPE_STUCK = 2;
      @verbatim (language="comment", text=
        "Injeta ruído aleatório de alta frequência inviabilizando o uso dos dados pelo EKF2")
      const uint8 FAILURE_TYPE_GARBAGE = 3;
      @verbatim (language="comment", text=
        "Aplica um offset estático constante corrompendo a calibração do sensor")
      const uint8 FAILURE_TYPE_WRONG = 4;
      @verbatim (language="comment", text=
        "Reduz a taxa de atualização drástica do componente simulando sobrecarga de barramento")
      const uint8 FAILURE_TYPE_SLOW = 5;
      @verbatim (language="comment", text=
        "Introduz um atraso temporal fixo na chegada das leituras ao estimador")
      const uint8 FAILURE_TYPE_DELAYED = 6;
      @verbatim (language="comment", text=
        "Alterna o funcionamento aleatoriamente entre operacional e em falha")
      const uint8 FAILURE_TYPE_INTERMITTENT = 7;
      @verbatim (language="comment", text=
        "Tipos de referência de velocidade para o comando VEHICLE_CMD_DO_CHANGE_SPEED (Injetado via param1)" "\n"        "Velocidade relativa ao ar (Crucial para sustentação aerodinâmica de asas fixas)")
      const uint8 SPEED_TYPE_AIRSPEED = 0;
      @verbatim (language="comment", text=
        "Velocidade real em relação ao solo obtida via GPS/Filtro")
      const uint8 SPEED_TYPE_GROUNDSPEED = 1;
      @verbatim (language="comment", text=
        "Velocidade vertical positiva de subida")
      const uint8 SPEED_TYPE_CLIMB_SPEED = 2;
      @verbatim (language="comment", text=
        "Velocidade vertical negativa de descida")
      const uint8 SPEED_TYPE_DESCEND_SPEED = 3;
      @verbatim (language="comment", text=
        "Comportamento de orientação do Yaw durante a execução do comando de órbita (Injetado via param3)" "\n"        "Mantém o nariz do drone apontado fixamente para o centro da órbita")
      const uint8 ORBIT_YAW_BEHAVIOUR_HOLD_FRONT_TO_CIRCLE_CENTER = 0;
      @verbatim (language="comment", text=
        "Trava a proa no ângulo que estava no momento do início do comando")
      const uint8 ORBIT_YAW_BEHAVIOUR_HOLD_INITIAL_HEADING = 1;
      @verbatim (language="comment", text=
        "Desativa o controle de guinada automático deixando o Yaw livre")
      const uint8 ORBIT_YAW_BEHAVIOUR_UNCONTROLLED = 2;
      @verbatim (language="comment", text=
        "Alinha o nariz do drone tangencialmente apontando para a direção do movimento")
      const uint8 ORBIT_YAW_BEHAVIOUR_HOLD_FRONT_TANGENT_TO_CIRCLE = 3;
      @verbatim (language="comment", text=
        "Permite que o piloto altere o Yaw manualmente via rádio sem quebrar a trajetória")
      const uint8 ORBIT_YAW_BEHAVIOUR_RC_CONTROLLED = 4;
      @verbatim (language="comment", text=
        "Mantém o comportamento de orientação de Yaw configurado anteriormente no sistema")
      const uint8 ORBIT_YAW_BEHAVIOUR_UNCHANGED = 5;
      @verbatim (language="comment", text=
        "Ações básicas de armamento (Injetado via param1 em VEHICLE_CMD_COMPONENT_ARM_DISARM)")
      const int8 ARMING_ACTION_DISARM = 0;
      const int8 ARMING_ACTION_ARM = 1;
      @verbatim (language="comment", text=
        "Ações de controle de garras físicas de carga (Injetado via param2 em VEHICLE_CMD_DO_GRIPPER)" "\n"        "Abre o mecanismo liberando o objeto preso")
      const uint8 GRIPPER_ACTION_RELEASE = 0;
      @verbatim (language="comment", text=
        "Fecha o mecanismo prendendo a carga útil")
      const uint8 GRIPPER_ACTION_GRAB = 1;
      @verbatim (language="comment", text=
        "Define o tamanho máximo de retenção de mensagens não processadas na fila uORB")
      const uint8 ORB_QUEUE_LENGTH = 8;
      @verbatim (language="comment", text=
        "Endereçamento inicial padrão para executores customizados de modos de voo")
      const uint16 COMPONENT_MODE_EXECUTOR_START = 1000;
    };
    @verbatim (language="comment", text=
      "Vehicle Command uORB message. Used for commanding a mission / action / etc." "\n"
      "Follows the MAVLink COMMAND_INT / COMMAND_LONG definition." "\n"
      "" "\n"
      "@description Mensagem uORB central para envio de comandos de ação, modos e navegação." "\n"
      "Suporta a tradução direta de comandos MAVLink recebidos externamente (Companion/GCS)" "\n"
      "ou gerados internamente pelo executor de missões do PX4.")
    struct VehicleCommand {
      @verbatim (language="comment", text=
        "Tempo desde a inicialização do sistema (Time-sync / Epoch interno)")
      @unit (value="us")
      uint64 timestamp;

      @verbatim (language="comment", text=
        "--- DECLARAÇÃO DE VARIÁVEIS DO PAYLOAD REAIS DA MENSAGEM ---" "\n"
        "Parâmetro genérico 1 (Geralmente dados de controle, configurações e flags de sub-enums)")
      float param1;

      @verbatim (language="comment", text=
        "Parâmetro genérico 2 (Geralmente tempos de integração, ganhos secundários ou velocidades)")
      float param2;

      @verbatim (language="comment", text=
        "Parâmetro genérico 3 (Geralmente raios de órbita, limites dinâmicos ou direções de giro)")
      float param3;

      @verbatim (language="comment", text=
        "Parâmetro genérico 4 (Geralmente ângulos de orientação, atitudes de Yaw e máscaras de bits)")
      float param4;

      @verbatim (language="comment", text=
        "Parâmetro genérico 5 - Alta Precisão (Usado para transporte de coordenadas de Latitude global)")
      double param5;

      @verbatim (language="comment", text=
        "Parâmetro genérico 6 - Alta Precisão (Usado para transporte de coordenadas de Longitude global)")
      double param6;

      @verbatim (language="comment", text=
        "Parâmetro genérico 7 (Usado para transporte de altitudes ou parâmetros flutuantes finais)")
      float param7;

      @verbatim (language="comment", text=
        "Identificador Numérico de Comando Executável (Corresponde aos IDs VEHICLE_CMD_*)")
      uint32 command;

      @verbatim (language="comment", text=
        "Identificação do MAVLink System ID destino do comando")
      uint8 target_system;

      @verbatim (language="comment", text=
        "Identificação do MAVLink Component ID destino (0 envia em broadcast para todas as placas/periféricos)")
      uint8 target_component;

      @verbatim (language="comment", text=
        "Identificação do MAVLink System ID de quem gerou a mensagem (Ex: ID da Raspberry Pi)")
      uint8 source_system;

      @verbatim (language="comment", text=
        "Identificação do MAVLink Component ID / Executor de modo de quem originou o envio")
      uint16 source_component;

      @verbatim (language="comment", text=
        "Contador de pacotes de confirmação (0 para envio inicial, incrementos sequenciais para reenvios críticos)")
      uint8 confirmation;

      @verbatim (language="comment", text=
        "Flag de auditoria de segurança (Define se a origem é um link externo MAVLink ou nativa interna)")
      boolean from_external;
    };
  };
};
